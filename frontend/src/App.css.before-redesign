.ticket-details-shell .discussion-character-count {
  color: #9997aa;
  font-size: 11px;
}

.ticket-details-shell .discussion-post-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  min-height: 43px;
  padding: 11px 19px !important;
  border: 1px solid #7545d5 !important;
  border-radius: 11px !important;
  background: #7545d5 !important;
  color: #ffffff !important;
  font-size: 13px !important;
  font-weight: 750 !important;
  box-shadow: 0 4px 10px rgba(117, 69, 213, 0.17);
  cursor: pointer;
  transition: background 0.2s ease, transform 0.2s ease,
    box-shadow 0.2s ease;
}

.ticket-details-shell .discussion-post-button:hover:not(:disabled) {
  background: #6033bd !important;
  border-color: #6033bd !important;
  box-shadow: 0 6px 14px rgba(117, 69, 213, 0.25);
  transform: translateY(-1px);
}

.ticket-details-shell .discussion-post-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  box-shadow: none;
  transform: none;
}

.ticket-details-shell .discussion-error {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 11px 13px;
  border: 1px solid #fecaca;
  border-radius: 10px;
  background: #fff5f5;
  color: #b42318;
  font-size: 12px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.ticket-details-shell .discussion-loading {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 18px 0;
  color: #77748d;
  font-size: 13px;
}

.ticket-details-shell .discussion-spinner,
.ticket-details-shell .discussion-button-spinner {
  display: inline-block;
  width: 16px;
  height: 16px;
  border: 2px solid #e4dcf9;
  border-top-color: #7545d5;
  border-radius: 50%;
  animation: discussion-spin 0.7s linear infinite;
  flex-shrink: 0;
}

.ticket-details-shell .discussion-button-spinner {
  width: 14px;
  height: 14px;
  border-color: rgba(255, 255, 255, 0.4);
  border-top-color: #ffffff;
}

@keyframes discussion-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 640px) {
  .ticket-details-shell .ticket-discussion-card {
    padding: 18px !important;
  }

  .ticket-details-shell .discussion-header {
    align-items: flex-start;
  }

  .ticket-details-shell .discussion-heading .ticket-section-title {
    font-size: 18px !important;
  }

  .ticket-details-shell .ticket-comment-card {
    padding: 12px !important;
  }

  .ticket-details-shell .discussion-form-footer {
    align-items: stretch;
  }

  .ticket-details-shell .discussion-post-button {
    width: 100%;
  }
}

