/* Ticket details: inline assignee selector and centered save button */
.ticket-assignment-row {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ticket-assignment-inline {
  display: grid;
  grid-template-columns: minmax(100px, 0.8fr) minmax(0, 1.5fr);
  align-items: center;
  gap: 12px;
  width: 100%;
}

.ticket-assignment-label {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0;
  white-space: nowrap;
}

.ticket-assignment-select {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.ticket-assignment-button-wrap {
  display: flex;
  justify-content: center;
  width: 100%;
}

.ticket-assignment-save {
  width: 65%;
  max-width: 260px;
}

@media (max-width: 480px) {
  .ticket-assignment-inline {
    grid-template-columns: minmax(90px, 0.8fr) minmax(0, 1.2fr);
    gap: 8px;
  }

  .ticket-assignment-label {
    font-size: 13px;
  }

  .ticket-assignment-save {
    width: 80%;
  }
}
