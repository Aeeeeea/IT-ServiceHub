const express = require("express");
const router = express.Router();
const db = require("../database");
const { authenticateToken } = require("../middleware/auth");

// SLA Status Helper

function getSLAStatus(ticket) {
  const status = String(ticket.status || "").trim().toLowerCase();
  const deadline = ticket.sla_deadline;

  // 1. Cancelled / Detached
  if (["cancelled", "canceled"].includes(status)) {
    return "Cancelled / Detached";
  }

  // 2. Paused / On Hold
  if (["on hold", "paused", "pending"].includes(status)) {
    return "Paused / On Hold";
  }

  // 3. Completed tickets
  if (["resolved", "closed", "completed"].includes(status)) {
    if (!deadline) {
      return "Met / Succeeded";
    }

    // resolved_at will be added in a later step.
    if (ticket.resolved_at) {
      const resolvedAt = new Date(ticket.resolved_at);
      const dueAt = new Date(deadline);

      if (
        !Number.isNaN(resolvedAt.getTime()) &&
        !Number.isNaN(dueAt.getTime()) &&
        resolvedAt <= dueAt
      ) {
        return "Met / Succeeded";
      }
    }

    return "Breached / Violated";
  }

  // No SLA deadline available
  if (!deadline) {
    return "In Progress / Running";
  }

  const dueAt = new Date(deadline);
  const createdAt = new Date(ticket.created_at);
  const now = new Date();

  if (
    Number.isNaN(dueAt.getTime()) ||
    Number.isNaN(createdAt.getTime())
  ) {
    return "In Progress / Running";
  }

  const remaining = dueAt.getTime() - now.getTime();

  // 4. Breached / Violated
  if (remaining <= 0) {
    return "Breached / Violated";
  }

  // 5. Warning / At Risk:
  // 20% or less of the original SLA duration remains.
  const totalDuration = dueAt.getTime() - createdAt.getTime();

  if (
    totalDuration > 0 &&
    remaining / totalDuration <= 0.2
  ) {
    return "Warning / At Risk";
  }

  // 6. In Progress / Running
  return "In Progress / Running";
}


// GET all tickets
router.get("/", (req, res) => {
  try {
    const tickets = db
      .prepare(`
        SELECT
          tickets.*,
          requester.name AS requester_name,
          requester.email AS requester_email,
          assignee.name AS assigned_to_name
        FROM tickets
        LEFT JOIN users AS requester
          ON tickets.requester_id = requester.id
        LEFT JOIN users AS assignee
          ON tickets.assigned_to = assignee.id
        ORDER BY tickets.created_at DESC
      `)
      .all();

    res.json(
      tickets.map((ticket) => ({
        ...ticket,
        sla_status: getSLAStatus(ticket),
      }))
    );
  } catch (error) {
    console.error("Failed to retrieve tickets:", error);
    res.status(500).json({
      message: "Failed to retrieve tickets.",
    });
  }
});

// GET one ticket
router.get("/:id", (req, res) => {
  try {
    const ticket = db
      .prepare(`
        SELECT
          tickets.*,
          requester.name AS requester_name,
          requester.email AS requester_email,
          assignee.name AS assigned_to_name
        FROM tickets
        LEFT JOIN users AS requester
          ON tickets.requester_id = requester.id
        LEFT JOIN users AS assignee
          ON tickets.assigned_to = assignee.id
        WHERE tickets.id = ? OR tickets.ticket_number = ?
      `)
      .get(req.params.id, req.params.id);

    if (!ticket) {
      return res.status(404).json({
        message: "Ticket not found.",
      });
    }

    res.json({
      ...ticket,
      sla_status: getSLAStatus(ticket.sla_deadline),
    });
  } catch (error) {
    console.error("Failed to retrieve ticket:", error);
    res.status(500).json({
      message: "Failed to retrieve ticket.",
    });
  }
});

// CREATE ticket
router.post("/", (req, res) => {
  try {
    const {
      title,
      description,
      category,
      priority,
      requester_id,
      assigned_to,
    } = req.body;

    if (!title || !category) {
      return res.status(400).json({
        message: "Title and category are required.",
      });
    }

    const ticketNumber = `IT-${Date.now()}`;
    const slaHours = {
      Critical: 4,
      High: 8,
      Medium: 12,
      Low: 24,
    };

    const selectedPriority = priority || "Medium";
    const slaTargetHours = slaHours[selectedPriority] || 24;

    const slaDeadline = new Date(Date.now() + slaTargetHours * 60 * 60 * 1000)
      .toISOString()
      .slice(0, 19)
      .replace("T", " ");

    const result = db
      .prepare(`
        INSERT INTO tickets (
          ticket_number,
          title,
          description,
          category,
          priority,
          requester_id,
          assigned_to,
          sla_target_hours,
          sla_deadline
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
      `)
      .run(
        ticketNumber,
        title.trim(),
        description || "",
        category,
        selectedPriority,
        requester_id || null,
        assigned_to || null,
        slaTargetHours,
        slaDeadline
      );

    const ticket = db
      .prepare("SELECT * FROM tickets WHERE id = ?")
      .get(result.lastInsertRowid);

    res.status(201).json({
      message: "Ticket created successfully.",
      ticket: {
        ...ticket,
        sla_status: getSLAStatus(ticket.sla_deadline),
      },
    });
  } catch (error) {
    console.error("Failed to create ticket:", error);
    res.status(500).json({
      message: "Failed to create ticket.",
    });
  }
});

// UPDATE ticket
router.put("/:id", authenticateToken, (req, res) => {
  try {
    const { title, description, category, priority, status, assigned_to } =
      req.body;

    const existingTicket = db
      .prepare("SELECT * FROM tickets WHERE id = ? OR ticket_number = ?")
      .get(req.params.id, req.params.id);

    if (!existingTicket) {
      return res.status(404).json({
        message: "Ticket not found.",
      });
    }

    // STATUS PERMISSIONS
    if (status !== undefined) {
      if (existingTicket.status === "Closed") {
        return res.status(403).json({
          message: "Closed tickets cannot be modified.",
        });
      }

      if (req.user.role !== "admin" && req.user.role !== "it_staff") {
        return res.status(403).json({
          message: "Only Admin and IT Staff can update ticket status.",
        });
      }

      const itStaffStatuses = ["Open", "In Progress", "Resolved"];
      const adminStatuses = ["Open", "In Progress", "Resolved", "Closed"];
      const allowedStatuses =
        req.user.role === "admin" ? adminStatuses : itStaffStatuses;

      if (!allowedStatuses.includes(status)) {
        return res.status(403).json({
          message:
            req.user.role === "admin"
              ? "Invalid ticket status."
              : "IT Staff can only set tickets to Open, In Progress, or Resolved.",
        });
      }
    }

    // ASSIGNMENT PERMISSIONS
    if (
      assigned_to !== undefined &&
      req.user.role !== "admin" &&
      req.user.role !== "it_staff"
    ) {
      return res.status(403).json({
        message: "Only Admin and IT Staff can assign tickets.",
      });
    }

    // UPDATE TICKET
    db.prepare(`
      UPDATE tickets
      SET
        title = COALESCE(?, title),
        description = COALESCE(?, description),
        category = COALESCE(?, category),
        priority = COALESCE(?, priority),
        status = COALESCE(?, status),
        assigned_to = CASE
          WHEN ? IS NULL AND ? IS NOT NULL THEN NULL
          WHEN ? IS NOT NULL THEN ?
          ELSE assigned_to
        END,
        updated_at = CURRENT_TIMESTAMP
      WHERE id = ? OR ticket_number = ?
    `).run(
      title || null,
      description || null,
      category || null,
      priority || null,
      status || null,
      assigned_to,
      assigned_to,
      assigned_to,
      assigned_to,
      req.params.id,
      req.params.id
    );

    const updatedTicket = db
      .prepare(`
        SELECT
          tickets.*,
          requester.name AS requester_name,
          requester.email AS requester_email,
          assignee.name AS assigned_to_name
        FROM tickets
        LEFT JOIN users AS requester
          ON tickets.requester_id = requester.id
        LEFT JOIN users AS assignee
          ON tickets.assigned_to = assignee.id
        WHERE tickets.id = ? OR tickets.ticket_number = ?
      `)
      .get(req.params.id, req.params.id);

    res.json({
      message: "Ticket updated successfully.",
      ticket: {
        ...updatedTicket,
        sla_status: getSLAStatus(updatedTicket)
      },
    });
  } catch (error) {
    console.error("Failed to update ticket:", error);
    res.status(500).json({
      message: "Failed to update ticket.",
    });
  }
});


/** Delete a ticket and its related comments safely. */
router.delete("/:id", authenticateToken, (req, res) => {
  try {
    const { id } = req.params;

    // Accept either the numeric ID or ticket number.
    const ticket = db
      .prepare("SELECT id FROM tickets WHERE id = ? OR ticket_number = ?")
      .get(id, id);

    if (!ticket) {
      return res.status(404).json({
        message: "Ticket not found.",
      });
    }

    // Use a transaction so partial deletion is rolled back on failure.
    const deleteTicket = db.transaction((ticketId) => {
      // This is the actual comments table in your database.
      db.prepare(
        "DELETE FROM ticket_comments WHERE ticket_id = ?"
      ).run(ticketId);

      // Delete these only if the tables exist.
      for (const table of ["ticket_logs", "sla_history"]) {
        const exists = db
          .prepare(
            "SELECT name FROM sqlite_master WHERE type = 'table' AND name = ?"
          )
          .get(table);

        if (exists) {
          db.prepare(`DELETE FROM "${table}" WHERE ticket_id = ?`)
            .run(ticketId);
        }
      }

      return db
        .prepare("DELETE FROM tickets WHERE id = ?")
        .run(ticketId);
    });

    const result = deleteTicket(ticket.id);

    if (result.changes === 0) {
      return res.status(404).json({
        message: "Ticket not found.",
      });
    }

    res.json({
      message: "Ticket deleted successfully.",
    });
  } catch (error) {
    console.error("Failed to delete ticket:", error);

    res.status(500).json({
      message: "Failed to delete ticket.",
    });
  }
});


module.exports = router;